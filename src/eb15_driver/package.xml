<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eb15_driver</name>
  <version>0.1.0</version>
  <description>ROS 2 serial bridge driver for EB-15 robotic arm (Arduino Nano + AS5600 + TB6600)</description>
  <maintainer email="antonyjuza@gmail.com">Antony Juza</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>eb15_description</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
