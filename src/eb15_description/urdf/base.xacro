<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================= -->
  <!-- WORLD LINK & BASE FIXTURE                         -->
  <!-- ================================================= -->
  <link name="world"/>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================================================= -->
  <!-- BASE LINK (001 Base Plate + 002 Washer)           -->
  <!-- ================================================= -->
  <link name="base_link">
    <!-- 001 Base Plate -->
    <visual>
      <origin xyz="-0.100 -0.100 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/001.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <!-- 002 Washer (Thickness: 0.8mm) -->
    <visual>
      <origin xyz="-0.100 -0.100 0.030" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/002.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="metallic"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0525" length="0.030"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <mass value="0.50"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0012"/>
    </inertial>
  </link>

</robot>
