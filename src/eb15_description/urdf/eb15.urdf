<?xml version="1.0"?>
<robot name="eb15">

  <!-- ================================================= -->
  <!-- MATERIALS                                         -->
  <!-- ================================================= -->
  <material name="dark_gray">
    <color rgba="0.22 0.22 0.24 1.0"/>
  </material>

  <material name="light_white">
    <color rgba="0.94 0.94 0.96 1.0"/>
  </material>

  <material name="metallic">
    <color rgba="0.65 0.65 0.70 1.0"/>
  </material>

  <material name="accent_red">
    <color rgba="0.85 0.20 0.20 1.0"/>
  </material>


  <!-- ================================================= -->
  <!-- WORLD LINK & BASE FIXTURE                         -->
  <!-- ================================================= -->
  <link name="world"/>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  <!-- ================================================= -->
  <!-- BASE LINK (001 Base Plate + 002 Washer)           -->
  <!-- ================================================= -->
  <link name="base_link">
    <!-- 001 Base Plate -->
    <visual>
      <origin xyz="-0.100 -0.100 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/001.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <!-- 002 Washer (Thickness: 0.8mm) -->
    <visual>
      <origin xyz="-0.100 -0.100 0.030" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/002.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="metallic"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0525" length="0.030"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <mass value="0.50"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0012"/>
    </inertial>
  </link>


  <!-- ================================================= -->
  <!-- JOINT 1 (BASE PAN / YAW)                          -->
  <!-- ================================================= -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.0308" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="15.0" velocity="3.14"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>


  <!-- ================================================= -->
  <!-- LINK 1 (SHOULDER COLUMN: 003 + 004 Cap + 005)     -->
  <!-- ================================================= -->
  <link name="link1">
    <!-- 003 Shoulder Column Housing (Flat side at Z=0 sitting on washer 002) -->
    <visual>
      <origin xyz="-0.100 0.100 0.0" rpy="0 0 -1.5707963"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/003.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <!-- 004 Top Angle Cap -->
    <visual>
      <origin xyz="0.100 0.100 0.0942" rpy="3.14159265 0 -1.5707963"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/004.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_white"/>
    </visual>

    <!-- 005 Washer (Side face for Joint 2 actuator at Y = +0.040) -->
    <visual>
      <origin xyz="-0.100 0.040 0.143" rpy="-1.5707963 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/005.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="metallic"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.0425" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.040" length="0.085"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0.015 0.043" rpy="0 0 0"/>
      <mass value="0.75"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0008"/>
    </inertial>
  </link>


  <!-- ================================================= -->
  <!-- JOINT 2 (SHOULDER PITCH)                          -->
  <!-- ================================================= -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0.0838 0.043" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.570796" upper="1.570796" effort="15.0" velocity="3.14"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>


  <!-- ================================================= -->
  <!-- LINK 2 (UPPER ARM: 006 + 007 + 008 + 009 + 010    -->
  <!--                   + 011 + 012 + 013)              -->
  <!-- ================================================= -->
  <link name="link2">
    <!-- 006 Shoulder Joint Housing (Lying horizontally along pitch axis Y) -->
    <visual>
      <origin xyz="0.100 -0.043 -0.100" rpy="1.5707963 0 3.14159265"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/006.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <!-- 007 Shoulder Outer Cap (Caps opening of 006 at Y = +0.042) -->
    <visual>
      <origin xyz="-0.100 0.042 -0.100" rpy="1.5707963 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/007.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_white"/>
    </visual>

    <!-- 008 Washer (Sits on top neck of 006 at Z = 0.040, thickness: 3mm) -->
    <visual>
      <origin xyz="-0.100 -0.100 0.040" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/008.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="metallic"/>
    </visual>

    <!-- 009 Upper Arm White Tube (Length: 142mm, Z from 0.043 to 0.185) -->
    <visual>
      <origin xyz="-0.100 -0.100 0.043" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/009.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_white"/>
    </visual>

    <!-- 010 Washer (Sits at top of 009 at Z = 0.185, thickness: 3mm) -->
    <visual>
      <origin xyz="-0.100 -0.100 0.185" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/010.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="metallic"/>
    </visual>

    <!-- 011 Elbow Joint Housing (Lying horizontally along pitch axis Y at Z = 0.228) -->
    <visual>
      <origin xyz="0.100 -0.043 0.128" rpy="1.5707963 0 3.14159265"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/011.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <!-- 012 Elbow Outer Cap (Caps outer opening of 011 at Y = +0.042) -->
    <visual>
      <origin xyz="-0.100 0.042 0.128" rpy="1.5707963 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/012.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_white"/>
    </visual>

    <!-- 013 Washer (Mating face for Actuator 036 output at Y = -0.043, Z = 0.228) -->
    <visual>
      <origin xyz="-0.100 -0.043 0.128" rpy="1.5707963 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/013.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="metallic"/>
    </visual>

    <!-- Collision geometry -->
    <collision>
      <!-- Upper arm tube -->
      <origin xyz="0 0 0.114" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.148"/>
      </geometry>
    </collision>
    <collision>
      <!-- Shoulder cylinder -->
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.085"/>
      </geometry>
    </collision>
    <collision>
      <!-- Elbow cylinder -->
      <origin xyz="0 0 0.228" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.085"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.114" rpy="0 0 0"/>
      <mass value="1.20"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.001"/>
    </inertial>
  </link>


  <!-- ================================================= -->
  <!-- JOINT 3 (ELBOW PITCH)                             -->
  <!-- ================================================= -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 -0.0838 0.228" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="12.0" velocity="3.14"/>
    <dynamics damping="0.4" friction="0.1"/>
  </joint>


  <!-- ================================================= -->
  <!-- LINK 3 (FOREARM: 014 + 015)                       -->
  <!-- ================================================= -->
  <link name="link3">
    <!-- 014 Elbow Bracket (Mates to washer 013, returns forearm to central plane Y=0) -->
    <visual>
      <origin xyz="-0.100 0.040 -0.095" rpy="1.5707963 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/014.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <!-- 015 Forearm White Tube (Length: 130mm, sitting on 014 at Z = 0.048) -->
    <visual>
      <origin xyz="-0.100 -0.100 0.048" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/015.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_white"/>
    </visual>

    <!-- Collision geometry -->
    <collision>
      <!-- Forearm tube -->
      <origin xyz="0 0 0.113" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.130"/>
      </geometry>
    </collision>
    <collision>
      <!-- Elbow bracket -->
      <origin xyz="0 0.020 0.024" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.073"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.090" rpy="0 0 0"/>
      <mass value="0.80"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.0006"/>
    </inertial>
  </link>


  <!-- ================================================= -->
  <!-- WRIST BASE (FIXED ADAPTER TO FOREARM TUBE 015)    -->
  <!-- ================================================= -->
  <joint name="wrist_base_joint" type="fixed">
    <parent link="link3"/>
    <child link="wrist_base_link"/>
    <origin xyz="0 0 0.178" rpy="0 0 0"/>
  </joint>

  <link name="wrist_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/wrist_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.037" rpy="0 0 0"/>
      <geometry>
        <box size="0.082 0.069 0.075"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.037" rpy="0 0 0"/>
      <mass value="0.22"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>


  <!-- ================================================= -->
  <!-- WRIST JOINT (REVOLUTE WRIST ROLL - SERVO HORN)    -->
  <!-- ================================================= -->
  <joint name="wrist_joint" type="revolute">
    <parent link="wrist_base_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.570796" upper="1.570796" effort="5.0" velocity="3.14"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/wrist_rot.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_white"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.073" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.028" length="0.029"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.073" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>


  <!-- ================================================= -->
  <!-- TOOL0 (END EFFECTOR FRAME AT TOP OF SERVO HORN)   -->
  <!-- ================================================= -->
  <joint name="tool_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.0877" rpy="0 0 0"/>
  </joint>

  <link name="tool0"/>

  <!-- ================================================= -->
  <!-- EBG-20 ADAPTIVE ROBOT GRIPPER                     -->
  <!-- ================================================= -->
  <!-- Fixed base attached to tool0: wrist piece inserts 9.5mm into collar of 002 -->
  <joint name="gripper_base_joint" type="fixed">
    <parent link="tool0"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 -0.0095" rpy="0 0 0"/>
  </joint>

  <link name="gripper_base_link">
    <!-- Main Housing (002 + 003 + 015 Pinion) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/gripper_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <!-- Front Cover Plate (004) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/gripper_cover.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_white"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.0385" rpy="0 0 0"/>
      <geometry>
        <box size="0.085 0.065 0.077"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.0385" rpy="0 0 0"/>
      <mass value="0.22"/>
      <inertia ixx="0.00015" ixy="0" ixz="0" iyy="0.00018" iyz="0" izz="0.00012"/>
    </inertial>
  </link>


  <!-- ================================================= -->
  <!-- GRIPPER LEFT FINGER (010 + 011 + 007 + 008 + 009) -->
  <!-- Prismatic joint sliding along X (inward to close) -->
  <!-- ================================================= -->
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="gripper_left_finger_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.020" effort="20.0" velocity="0.05"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="gripper_left_finger_link">
    <!-- Finger Body & Rack (010 + 011 + 007 + 008) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/gripper_left_finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <!-- White Grip Pad (009) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/gripper_left_pad.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_white"/>
    </visual>

    <collision>
      <origin xyz="-0.020 0 0.098" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.021 0.040"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="-0.015 0 0.088" rpy="0 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>


  <!-- ================================================== -->
  <!-- GRIPPER RIGHT FINGER (005 + 006 + 012 + 013 + 014) -->
  <!-- Prismatic joint sliding along -X (mimics left)     -->
  <!-- ================================================== -->
  <joint name="gripper_right_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="gripper_right_finger_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0.0" upper="0.020" effort="20.0" velocity="0.05"/>
    <mimic joint="gripper_left_joint" multiplier="1.0" offset="0.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="gripper_right_finger_link">
    <!-- Finger Body & Rack (005 + 006 + 012 + 013) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/gripper_right_finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <!-- White Grip Pad (014) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/gripper_right_pad.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_white"/>
    </visual>

    <collision>
      <origin xyz="0.020 0 0.098" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.021 0.040"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.015 0 0.088" rpy="0 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>


  <!-- ================================================= -->
  <!-- GRIPPER TCP (TOOL CENTER POINT / GRASP FRAME)     -->
  <!-- ================================================= -->
  <joint name="gripper_tcp_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="gripper_tcp"/>
    <origin xyz="0 0 0.098" rpy="0 0 0"/>
  </joint>

  <link name="gripper_tcp">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.004"/>
      </geometry>
      <material name="accent_red"/>
    </visual>
  </link>

</robot>
