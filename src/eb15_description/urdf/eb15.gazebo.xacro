<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="eb15_gazebo" params="controllers_yaml">
    <!-- Gazebo Sim ros2_control System Plugin -->
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers_yaml}</parameters>
        <controller_manager_node_name>controller_manager</controller_manager_node_name>
      </plugin>
    </gazebo>

    <!-- Base link physics & surface properties -->
    <gazebo reference="base_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <self_collide>false</self_collide>
    </gazebo>

    <!-- Link 1 (Shoulder) -->
    <gazebo reference="link1">
      <material>Gazebo/DarkGrey</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <self_collide>false</self_collide>
    </gazebo>

    <!-- Link 2 (Upper Arm) -->
    <gazebo reference="link2">
      <material>Gazebo/White</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <self_collide>false</self_collide>
    </gazebo>

    <!-- Link 3 (Forearm) -->
    <gazebo reference="link3">
      <material>Gazebo/White</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <self_collide>false</self_collide>
    </gazebo>

    <!-- Wrist Base & Rotating Link -->
    <gazebo reference="wrist_base_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="wrist_link">
      <material>Gazebo/White</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <self_collide>false</self_collide>
    </gazebo>

    <!-- Gripper Base & Fingers -->
    <gazebo reference="gripper_base_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="gripper_left_finger_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <kp>1000000.0</kp>
      <kd>1.0</kd>
      <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="gripper_right_finger_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <kp>1000000.0</kp>
      <kd>1.0</kd>
      <self_collide>false</self_collide>
    </gazebo>

  </xacro:macro>

</robot>
