<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================= -->
  <!-- JOINT 2 (SHOULDER PITCH)                          -->
  <!-- ================================================= -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0.0838 0.043" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.570796" upper="1.570796" effort="15.0" velocity="3.14"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- ================================================= -->
  <!-- LINK 2 (UPPER ARM: 006..013)                      -->
  <!-- ================================================= -->
  <link name="link2">
    <!-- 006 Shoulder Joint Housing -->
    <visual>
      <origin xyz="0.100 -0.043 -0.100" rpy="1.5707963 0 3.14159265"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/006.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <!-- 007 Shoulder Outer Cap -->
    <visual>
      <origin xyz="-0.100 0.042 -0.100" rpy="1.5707963 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/007.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_white"/>
    </visual>

    <!-- 008 Washer -->
    <visual>
      <origin xyz="-0.100 -0.100 0.040" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/008.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="metallic"/>
    </visual>

    <!-- 009 Upper Arm White Tube -->
    <visual>
      <origin xyz="-0.100 -0.100 0.043" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/009.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_white"/>
    </visual>

    <!-- 010 Washer -->
    <visual>
      <origin xyz="-0.100 -0.100 0.185" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/010.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="metallic"/>
    </visual>

    <!-- 011 Elbow Joint Housing -->
    <visual>
      <origin xyz="0.100 -0.043 0.128" rpy="1.5707963 0 3.14159265"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/011.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <!-- 012 Elbow Outer Cap -->
    <visual>
      <origin xyz="-0.100 0.042 0.128" rpy="1.5707963 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/012.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_white"/>
    </visual>

    <!-- 013 Washer -->
    <visual>
      <origin xyz="-0.100 -0.043 0.128" rpy="1.5707963 0 0"/>
      <geometry>
        <mesh filename="package://eb15_description/meshes/013.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="metallic"/>
    </visual>

    <!-- Collision geometry -->
    <collision>
      <origin xyz="0 0 0.114" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.148"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.085"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.228" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.085"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.114" rpy="0 0 0"/>
      <mass value="1.20"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.001"/>
    </inertial>
  </link>

</robot>
